{
  "entities": {
    "Product": {
      "title": "Product Ad",
      "description": "Classified ad listing on MarketBD.Net",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "price": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "division": { "type": "string", "maxLength": 64 },
        "district": { "type": "string", "maxLength": 64 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "approved", "pending", "rejected", "sold", "expired"] },
        "showPhoneNumber": { "type": "boolean", "description": "Whether the seller allowed buyers to see their phone number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["title", "price", "category"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Registered buyer or seller profile on MarketBD.Net",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 25 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["buyer", "seller", "admin"] },
        "isVerified": { "type": "boolean" }
      },
      "required": ["name", "phone"]
    },
    "ChatThread": {
      "title": "Chat Thread",
      "description": "Buyer-seller and customer care conversation container",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "buyerId": { "type": "string", "maxLength": 128 },
        "buyerName": { "type": "string", "maxLength": 120 },
        "buyerPhone": { "type": "string", "maxLength": 30 },
        "buyerEmail": { "type": "string", "maxLength": 150 },
        "isCustomerCare": { "type": "boolean" },
        "lastMessage": { "type": "string", "maxLength": 2000 },
        "lastMessageTime": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "productId", "buyerId"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "In-app buyer to seller chat message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["senderId", "receiverId", "text"]
    },
    "AdminActivityLog": {
      "title": "Admin Activity Log",
      "description": "Audit trail of key administrative operations performed by staff and superadmins",
      "type": "object",
      "properties": {
        "adminId": { "type": "string", "maxLength": 128 },
        "adminName": { "type": "string", "maxLength": 100 },
        "adminEmail": { "type": "string", "maxLength": 150 },
        "action": { "type": "string", "maxLength": 200 },
        "actionType": { "type": "string", "enum": ["ad_moderation", "site_maintenance", "user_management", "system_settings", "security"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "targetTitle": { "type": "string", "maxLength": 250 },
        "details": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["adminName", "action", "actionType", "timestamp"]
    },
    "ManualPayment": {
      "title": "Manual Payment Submission",
      "description": "User manual MFS payment verification submission (bKash, Nagad, Rocket)",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "paymentMethod": { "type": "string", "enum": ["bKash", "Nagad", "Rocket", "Upay"] },
        "transactionId": { "type": "string", "maxLength": 100 },
        "submittedAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending_verification", "verified", "rejected"] }
      },
      "required": ["orderId", "paymentMethod", "transactionId", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public classified ad listings"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account profiles and verification badges"
    },
    "/chats/{chatId}": {
      "schema": "ChatThread",
      "description": "Buyer-seller chat threads"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Direct messaging between buyers and sellers"
    },
    "/admin_logs/{logId}": {
      "schema": "AdminActivityLog",
      "description": "Real-time admin activity and audit trail logs"
    },
    "/activities/{activityId}": {
      "schema": "AdminActivityLog",
      "description": "System and user activity records"
    },
    "/payments/{paymentId}": {
      "schema": "ManualPayment",
      "description": "Manual payment verification records"
    }
  }
}
