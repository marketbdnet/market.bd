rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "admin@marketbd.net" ||
        request.auth.token.email == "official.marketbd@gmail.com" ||
        request.auth.token.email == "official.marketsbd@gmail.com" ||
        request.auth.token.admin == true
      );
    }

    // Products / Classified Ads - Public browse, owner/admin mutation
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() || (request.resource.data.title != null && request.resource.data.price != null);
      allow update: if isAdmin() || (isSignedIn() && (resource.data.seller.id == request.auth.uid || resource.data.sellerId == request.auth.uid || request.resource.data.views != null));
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.seller.id == request.auth.uid || resource.data.sellerId == request.auth.uid));
    }

    // User Profiles - Owner or Admin management
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() || request.resource.data.phone != null;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Chat System & Direct Messages
    match /chats/{chatId} {
      allow read: if isSignedIn() || true;
      allow write: if isSignedIn() || true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Customer Care & System Activity Logs
    match /activities/{activityId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Admin Activity & Audit Trail Logs
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // System Settings & Site Configuration (Maintenance, Notice, Payment Accounts, etc.)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }
  }
}

