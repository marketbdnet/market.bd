rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && (
          request.auth.token.email == "admin@marketbd.net" ||
          request.auth.token.email == "official.marketbd@gmail.com" ||
          request.auth.token.email == "official.marketsbd@gmail.com" ||
          request.auth.token.email == "graphicsdesign23@gmail.com"
        )) ||
        request.auth.token.admin == true
      );
    }

    // Connection test probe used on startup
    match /test/connection {
      allow get: if true;
    }

    // Products / Classified Ads - Unified Web & Android Realtime Sync
    match /products/{productId} {
      allow list: if true;
      allow get: if isValidId(productId);
      allow create, update: if isValidId(productId)
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200;
      allow delete: if isValidId(productId) && isAdmin();
    }

    // User Profiles - Owner or Admin write protection
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isValidId(userId)
        && (isSignedIn() || request.resource.data.phone != null)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && (!('role' in request.resource.data) || request.resource.data.role in ['buyer', 'seller'] || isAdmin());
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow delete: if isValidId(userId) && isAdmin();
    }

    function isValidChatThread(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.productId is string && data.productId.size() > 0 && data.productId.size() <= 128
        && data.buyerId is string && data.buyerId.size() > 0 && data.buyerId.size() <= 128
        && (!('buyerName' in data) || (data.buyerName is string && data.buyerName.size() <= 120))
        && (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 2000))
        && (!('messages' in data) || (data.messages is list && data.messages.size() <= 500));
    }

    // Chat System & Direct Messages (Buyer <-> Seller <-> Admin real-time sync)
    match /chats/{chatId} {
      allow list: if true;
      allow get: if isValidId(chatId);
      allow create, update: if isValidId(chatId) && isValidChatThread(request.resource.data);
      allow delete: if isValidId(chatId) && (isAdmin() || resource.data.buyerId is string);

      match /messages/{messageId} {
        allow read: if isValidId(chatId);
        allow create, update: if isValidId(chatId) && isValidId(messageId)
          && request.resource.data.senderId is string
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000;
        allow delete: if isValidId(chatId) && isValidId(messageId) && isAdmin();
      }
    }

    // User Notifications
    match /user_notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update: if isValidId(notificationId) && isSignedIn();
      allow delete: if isValidId(notificationId) && isAdmin();
    }

    // Customer Care & System Activity Logs
    match /activities/{activityId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isValidId(activityId);
      allow update, delete: if isValidId(activityId) && isAdmin();
    }

    // Admin Activity & Audit Trail Logs
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isValidId(logId) && isSignedIn();
      allow update, delete: if isValidId(logId) && isAdmin();
    }

    // System Settings & Site Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    // Manual Payment Verification System
    match /payments/{paymentId} {
      allow read: if true;
      allow create: if isValidId(paymentId) && request.resource.data.status == 'pending_verification';
      allow update, delete: if isValidId(paymentId) && isAdmin();
    }
  }
}
